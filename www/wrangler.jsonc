{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "vidm",
	"main": "./worker.ts",
	"compatibility_date": "2026-08-08",
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"routes": [{ "pattern": "vidm.phons.dev", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": true,
	"r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "vidm-assets" }]
}
