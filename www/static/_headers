/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Large WASM/model assets served from R2 via worker.ts (Workers migration —
# these used to be Pages Functions) — immutable, versioned by filename in
# practice (these don't change without a code change), so cache them for a
# year rather than re-downloading on every visit.
/ffmpeg/ffmpeg-core.wasm
  Cache-Control: public, max-age=31536000, immutable

/whisper/ggml-tiny.en-q5_1.bin
  Cache-Control: public, max-age=31536000, immutable

/models/whisper-webgpu/onnx/encoder_model_fp16.onnx
  Cache-Control: public, max-age=31536000, immutable

/models/whisper-webgpu/onnx/decoder_model_merged_q4f16.onnx
  Cache-Control: public, max-age=31536000, immutable

# Every onnxruntime runtime variant, not just one: the browser picks between
# the plain/.jsep/.jspi/.asyncify builds at runtime, so any of them may be the
# one actually fetched. They are versioned by the pinned onnxruntime-web
# dependency and never change in place.
/ort/*
  Cache-Control: public, max-age=31536000, immutable
