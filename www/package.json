{
	"name": "vidm",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "node scripts/inject-csp-hashes.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "node scripts/copy-ffmpeg-core.mjs && node scripts/setup-whisper.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
