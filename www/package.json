		"test": "vitest run"
	},
	"dependencies": {
		"@ffmpeg/ffmpeg": "^0.12.15",
		"@ffmpeg/util": "^0.12.2",
		"@huggingface/transformers": "4.2.0",
		"@lucide/svelte": "^1.31.0",
		"@transcribe/shout": "^1.0.7",
		"@transcribe/transcriber": "^3.0.1",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	},
	"devDependencies": {
		"@ffmpeg/core-mt": "^0.12.10",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vitest": "^4.1.10",
		"wrangler": "^4.123.0"
	},
	"pnpm": {
		"overrides": {
			"adm-zip": ">=0.6.0",
			"sharp": ">=0.35.0",
			"cookie": ">=0.7.0"
		}
	}
